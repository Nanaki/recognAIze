{
  "name": "recognaize",
  "version": "1.0.0",
  "description": "Outil CLI déterministe et sans réseau qui annonce le rang AI-Driven Development d'un profil de développeur sur la grille laivel-up.",
  "type": "module",
  "license": "MIT",
  "author": "Sébastien Nicolas",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "recognaize": "bin/recognaize.cjs"
  },
  "scripts": {
    "prebuild": "tsx scripts/gen-checks-index.ts && tsx scripts/gen-concept-details.ts",
    "checks:index": "tsx scripts/gen-checks-index.ts",
    "concepts:generate": "tsx scripts/gen-concept-details.ts",
    "build": "tsc && npm run build:assets",
    "build:assets": "node scripts/build-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "eval": "tsx evals/run.ts"
  },
  "keywords": [],
  "dependencies": {
    "commander": "^14.0.3",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "fast-check": "^4.9.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
