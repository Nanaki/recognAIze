{
  "schema_version": "1.0.0",
  "axes": [
    {
      "id": "T",
      "label": "Taille",
      "reference_source": ["GA", "PR"],
      "marches": [
        {
          "id": "T1",
          "label": "tâche S",
          "default": true,
          "proof_paths": [],
          "counter_proof": null
        },
        {
          "id": "T2",
          "label": "feature M",
          "default": false,
          "proof_paths": [
            {
              "path_id": "T2.p1",
              "description": "GA médiane size_distribution ≥ M",
              "force": "prouve",
              "signal_id": "GA.size_median",
              "source": "GA"
            },
            {
              "path_id": "T2.p2",
              "description": "PR médiane (fichiers 5-12 ou lignes 150-500)",
              "force": "prouve",
              "signal_id": "PR.median_files_or_lines_changed",
              "source": "PR"
            },
            {
              "path_id": "T2.p3",
              "description": "S : session touchant ≥ 3 fichiers d'un module",
              "force": "indice",
              "signal_id": "S.files_touched_single_module",
              "source": "S"
            },
            {
              "path_id": "T2.p4",
              "description": "SU : skill/agent spécifique orienté taille (multi-fichiers, migration, plusieurs couches)",
              "force": "indice",
              "signal_id": "SU.size_oriented_setup_present",
              "source": "SU"
            }
          ],
          "counter_proof": {
            "description": "GA/PR médiane ≤ S (taille S)",
            "signal_id": "GA.size_median"
          }
        },
        {
          "id": "T3",
          "label": "feature L planifiée",
          "default": false,
          "proof_paths": [
            {
              "path_id": "T3.p1",
              "description": "GA médiane ≥ L",
              "force": "prouve",
              "signal_id": "GA.size_median",
              "source": "GA"
            },
            {
              "path_id": "T3.p2",
              "description": "PR médiane > 12 fichiers ou ≥ 2 couches",
              "force": "prouve",
              "signal_id": "PR.median_files_or_layers_changed",
              "source": "PR"
            },
            {
              "path_id": "T3.p3",
              "description": "S : plan en phases + ≥ 2 couches",
              "force": "indice",
              "signal_id": "S.phased_plan_multi_layer",
              "source": "S"
            }
          ],
          "counter_proof": {
            "description": "GA/PR médiane ≤ M",
            "signal_id": "GA.size_median"
          }
        },
        {
          "id": "T4",
          "label": "XL master plan",
          "default": false,
          "proof_paths": [
            {
              "path_id": "T4.p1",
              "description": "GA xl ≥ 20 % des PR",
              "force": "prouve",
              "signal_id": "GA.xl_ratio",
              "source": "GA"
            }
          ],
          "counter_proof": {
            "description": "GA/PR : aucune PR XL",
            "signal_id": "GA.xl_ratio"
          }
        }
      ]
    },
    {
      "id": "H",
      "label": "Harness",
      "reference_source": ["GA", "RC"],
      "marches": [
        {
          "id": "H1",
          "label": "prompts structurés",
          "default": true,
          "proof_paths": [],
          "counter_proof": null
        },
        {
          "id": "H2",
          "label": "identité projet",
          "default": false,
          "proof_paths": [
            {
              "path_id": "H2.p1",
              "description": "RC fichier d'identité spécifique",
              "force": "prouve",
              "signal_id": "RC.identity_file_specific",
              "source": "RC"
            },
            {
              "path_id": "H2.p2",
              "description": "GA agents_md = true",
              "force": "prouve",
              "signal_id": "GA.agents_md",
              "source": "GA"
            }
