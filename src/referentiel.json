          }
        },
        {
          "id": "P3",
          "label": "≥ 3 habituellement",
          "default": false,
          "proof_paths": [
            {
              "path_id": "P3.p1",
              "description": "GA median_concurrent_branches ≥ 3",
              "force": "prouve",
              "signal_id": "GA.median_concurrent_branches",
              "source": "GA"
            },
            {
              "path_id": "P3.p2",
              "description": "PR recouvrement médian (created→merged) ≥ 3",
              "force": "prouve",
              "signal_id": "PR.median_overlap_count",
              "source": "PR"
            }
          ],
          "counter_proof": {
            "description": "GA médiane < 3 ; PR recouvrement médian < 3",
            "signal_id": "GA.median_concurrent_branches"
          }
        }
      ]
    },
    {
      "id": "O",
      "label": "Ownership",
      "reference_source": ["GA", "RC"],
