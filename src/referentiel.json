  "thresholds": {
    "T2.p1": { "kind": "condition", "signal_id": "GA.size_median", "comparator": "gte", "value": "M", "value_type": "enum", "unit": "taille_bucket" },
    "T2.p2": {
      "kind": "or",
      "of": [
        {
          "kind": "and",
          "of": [
            { "kind": "condition", "signal_id": "PR.median_files_changed", "comparator": "gte", "value": 5, "value_type": "count", "unit": "fichiers" },
            { "kind": "condition", "signal_id": "PR.median_files_changed", "comparator": "lte", "value": 12, "value_type": "count", "unit": "fichiers" }
          ]
        },
        {
          "kind": "and",
          "of": [
            { "kind": "condition", "signal_id": "PR.median_lines_changed", "comparator": "gte", "value": 150, "value_type": "count", "unit": "lignes" },
            { "kind": "condition", "signal_id": "PR.median_lines_changed", "comparator": "lte", "value": 500, "value_type": "count", "unit": "lignes" }
          ]
        }
      ]
    },
    "T2.p3": { "kind": "condition", "signal_id": "S.files_touched_single_module", "comparator": "gte", "value": 3, "value_type": "count", "unit": "fichiers" },
    "T2.p4": { "kind": "condition", "signal_id": "SU.size_oriented_setup_present", "comparator": "eq", "value": true, "value_type": "boolean" },
    "T3.p1": { "kind": "condition", "signal_id": "GA.size_median", "comparator": "gte", "value": "L", "value_type": "enum", "unit": "taille_bucket" },
    "T3.p2": {
      "kind": "or",
      "of": [
        { "kind": "condition", "signal_id": "PR.median_files_changed", "comparator": "gt", "value": 12, "value_type": "count", "unit": "fichiers" },
        { "kind": "condition", "signal_id": "PR.median_layers_touched", "comparator": "gte", "value": 2, "value_type": "count", "unit": "couches" }
      ]
    },
    "T3.p3": {
      "kind": "and",
      "of": [
        { "kind": "condition", "signal_id": "S.has_phased_plan", "comparator": "eq", "value": true, "value_type": "boolean" },
        { "kind": "condition", "signal_id": "S.layers_touched", "comparator": "gte", "value": 2, "value_type": "count", "unit": "couches" }
      ]
    },
    "T4.p1": { "kind": "condition", "signal_id": "GA.xl_ratio", "comparator": "gte", "value": 0.2, "value_type": "ratio", "unit": "ratio" },
    "H2.p1": { "kind": "condition", "signal_id": "RC.identity_file_specific", "comparator": "eq", "value": true, "value_type": "boolean" },
    "H2.p2": { "kind": "condition", "signal_id": "GA.agents_md", "comparator": "eq", "value": true, "value_type": "boolean" },
    "H3.p1": {
      "kind": "and",
      "of": [
        { "kind": "condition", "signal_id": "RC.memory_files_specific_count", "comparator": "gte", "value": 1, "value_type": "count", "unit": "fichiers" },
        { "kind": "condition", "signal_id": "RC.memory_files_alive", "comparator": "eq", "value": true, "value_type": "boolean" }
      ]
    },
    "H3.p2": {
      "kind": "and",
      "of": [
        { "kind": "condition", "signal_id": "GA.agents_md", "comparator": "eq", "value": true, "value_type": "boolean" },
        { "kind": "condition", "signal_id": "GA.agents_md_last_updated_in_window", "comparator": "eq", "value": true, "value_type": "boolean" }
      ]
    },
    "H4.p1": { "kind": "condition", "signal_id": "RC.behavior_artifacts_specific_count", "comparator": "gte", "value": 1, "value_type": "count", "unit": "artefacts" },
    "H4.p2": { "kind": "condition", "signal_id": "GA.rules_skills_agents_count", "comparator": "gte", "value": 1, "value_type": "count", "unit": "artefacts" },
    "H5.p1": { "kind": "condition", "signal_id": "RC.guardrail_artifact_present", "comparator": "eq", "value": true, "value_type": "boolean" },
    "H5.p2": { "kind": "condition", "signal_id": "GA.hooks_count", "comparator": "gte", "value": 1, "value_type": "count", "unit": "hooks" },
    "H6.p1": { "kind": "condition", "signal_id": "RC.loop_artifact_executable", "comparator": "eq", "value": true, "value_type": "boolean" },
