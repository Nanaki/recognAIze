            }
          ],
          "counter_proof": {
            "description": "RC fourni sans artefact exécutable",
            "signal_id": "RC.loop_artifact_executable"
          }
        },
        {
          "id": "H7",
          "label": "orchestration gouvernée",
          "default": false,
          "proof_paths": [
            {
              "path_id": "H7.p1",
              "description": "RC orchestrateur multi-agents/workflow et evals ou trust tiers",
              "force": "prouve",
              "signal_id": "RC.governed_orchestration_present",
              "source": "RC"
            },
            {
              "path_id": "H7.p2",
              "description": "S : sous-agents orchestrés",
              "force": "indice",
              "signal_id": "S.subagents_orchestrated",
              "source": "S"
            }
          ],
          "counter_proof": {
            "description": "RC fourni sans orchestrateur",
            "signal_id": "RC.governed_orchestration_present"
          }
        }
      ]
    },
    {
      "id": "I",
      "label": "Intervention",
      "reference_source": ["GA"],
      "marches": [
        {
          "id": "I1",
          "label": "corrige après coup",
          "default": true,
          "proof_paths": [],
          "counter_proof": null
        },
        {
          "id": "I2",
          "label": "cadre avant",
          "default": false,
          "proof_paths": [
            {
              "path_id": "I2.p1",
              "description": "GA median_correction_commits_after_open ≤ 3",
              "force": "prouve",
              "signal_id": "GA.median_correction_commits_after_open",
              "source": "GA"
            },
            {
              "path_id": "I2.p2",
              "description": "S : premier prompt avec contexte, contraintes, cas limites",
              "force": "indice",
              "signal_id": "S.first_prompt_framed",
              "source": "S"
            },
            {
              "path_id": "I2.p3",
              "description": "SU : skill/agent spécifique cadrant l'autonomie (critères d'arrêt, jalons, sans validation)",
              "force": "indice",
              "signal_id": "SU.autonomous_framing_setup_present",
              "source": "SU"
            }
          ],
          "counter_proof": {
            "description": "GA corr > 3",
            "signal_id": "GA.median_correction_commits_after_open"
          }
        },
        {
          "id": "I3",
          "label": "aux étapes clés",
          "default": false,
          "proof_paths": [
            {
              "path_id": "I3.p1",
              "description": "GA median_correction_commits_after_open ≤ 1",
              "force": "prouve",
              "signal_id": "GA.median_correction_commits_after_open",
              "source": "GA"
            },
            {
              "path_id": "I3.p2",
              "description": "S : plan validé avant implémentation + interventions aux jalons",
              "force": "indice",
              "signal_id": "S.milestone_framing_present",
              "source": "S"
            }
          ],
          "counter_proof": {
            "description": "GA corr > 1",
            "signal_id": "GA.median_correction_commits_after_open"
          }
        },
        {
          "id": "I4",
          "label": "jamais une fois cadré",
          "default": false,
          "proof_paths": [
            {
              "path_id": "I4.p1",
              "description": "GA merged_without_human_edit_after_open / PR mergées dans period (ou / pull_requests.total en approximation) ≥ 0,8 et ai_coauthored_ratio ≥ 0,9",
              "force": "prouve",
              "signal_id": "GA.merged_without_human_edit_ratio",
              "source": "GA"
            }
          ],
          "counter_proof": {
            "description": "GA ratio < 0,8 ou co-autorat < 0,9",
            "signal_id": "GA.merged_without_human_edit_ratio"
          }
        },
        {
          "id": "I5",
          "label": "jamais, cadrage compris",
          "default": false,
          "proof_paths": [
            {
              "path_id": "I5.p1",
              "description": "PR ouvertes par un compte d'agent configuré (recognaize.config.json ; sans champ auteur ⇒ inconnu)",
              "force": "prouve",
              "signal_id": "PR.opened_by_configured_agent_account",
              "source": "PR"
            }
          ],
          "counter_proof": null
        }
      ]
    },
    {
      "id": "P",
      "label": "Parallèle",
      "reference_source": ["GA", "PR"],
      "marches": [
        {
          "id": "P1",
          "label": "un chantier",
          "default": true,
          "proof_paths": [],
