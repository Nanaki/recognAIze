    "I2.p3": { "kind": "condition", "signal_id": "SU.autonomous_framing_setup_present", "comparator": "eq", "value": true, "value_type": "boolean" },
    "I3.p1": { "kind": "condition", "signal_id": "GA.median_correction_commits_after_open", "comparator": "lte", "value": 1, "value_type": "count", "unit": "commits" },
    "I3.p2": { "kind": "condition", "signal_id": "S.milestone_framing_present", "comparator": "eq", "value": true, "value_type": "boolean" },
    "I4.p1": {
      "kind": "and",
      "of": [
        { "kind": "condition", "signal_id": "GA.merged_without_human_edit_ratio", "comparator": "gte", "value": 0.8, "value_type": "ratio", "unit": "ratio" },
        { "kind": "condition", "signal_id": "GA.ai_coauthored_ratio", "comparator": "gte", "value": 0.9, "value_type": "ratio", "unit": "ratio" }
      ]
