        {
          "id": "H5",
          "label": "guardrails",
          "default": false,
          "proof_paths": [
            {
              "path_id": "H5.p1",
              "description": "RC hook / deny-list / pre-commit / CI gate",
              "force": "prouve",
              "signal_id": "RC.guardrail_artifact_present",
              "source": "RC"
            },
            {
              "path_id": "H5.p2",
              "description": "GA hooks_count ≥ 1",
              "force": "prouve",
              "signal_id": "GA.hooks_count",
              "source": "GA"
            }
          ],
          "counter_proof": {
            "description": "GA hooks = 0 et RC sans guardrail",
            "signal_id": "GA.hooks_count"
          }
        },
        {
          "id": "H6",
          "label": "boucles (artefact exécutable)",
          "default": false,
          "proof_paths": [
            {
              "path_id": "H6.p1",
              "description": "RC artefact exécutable de boucle (script/hook/job CI relançant sur échec avec plafond)",
              "force": "prouve",
              "signal_id": "RC.loop_artifact_executable",
              "source": "RC"
            },
            {
              "path_id": "H6.p2",
              "description": "S : l'agent relance seul les checks jusqu'au vert",
              "force": "indice",
              "signal_id": "S.autonomous_retry_until_green",
